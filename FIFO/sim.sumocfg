<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="main.net.xml"/>
        <route-files value="routes.rou.xml"/>
        <additional-files value="guidelines.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>

    <gui_only>
        <gui-settings-file value="viewsettings.xml"/>
        <start value="true"/>
    </gui_only>

</configuration>